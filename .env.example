# Enterprise Approval System AI — Environment Configuration Example

# Server Configuration
FLASK_PORT_V3=8002
SECRET_KEY=your-secret-key-placeholder

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# Formatting & Pagination Config
MAX_TABLE_ROWS=20
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50

# Data Provider Configuration (excel | easy_api)
DATA_PROVIDER_TYPE=excel

# Microsoft Entra ID (Azure AD) Single Sign-On Config
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=your-entra-client-id-placeholder
